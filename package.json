{
  "name": "@instawp/mcp-wp",
  "version": "0.2.4",
  "description": "A Model Context Protocol server for WordPress with contract-driven custom content types.",
  "type": "module",
  "main": "./build/server.js",
  "exports": "./build/server.js",
  "bin": {
    "mcp-wp": "./build/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InstaWP/mcp-wp.git"
  },
  "homepage": "https://github.com/InstaWP/mcp-wp#readme",
  "bugs": {
    "url": "https://github.com/InstaWP/mcp-wp/issues"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node ./build/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run && tsx --test test/*.test.ts",
    "test:watch": "vitest",
    "clean": "rimraf build",
    "prepare": "npm run build"
  },
  "keywords": [
    "wordpress",
    "mcp",
    "server",
    "claude",
    "ai",
    "instawp",
    "custom-post-types",
    "eventon"
  ],
  "author": "Claude",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "form-data": "^4.0.6",
    "fs-extra": "^11.4.1",
    "marked": "^18.2.0",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "proxy-addr": "2.0.8",
    "follow-redirects": "1.16.3"
  }
}
