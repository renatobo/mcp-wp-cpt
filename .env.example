# WordPress API configuration
# The standard WordPress REST API endpoint
WORDPRESS_API_URL=https://your-wordpress-site.com
# For authentication using Application Passwords (WordPress 5.6+)
WORDPRESS_USERNAME=your_username
WORDPRESS_PASSWORD=your_app_password

# Keep dotenv from writing startup logs to MCP's JSON-RPC stdout
DOTENV_CONFIG_QUIET=true

# Media uploads (create_media). Local file_path uploads are disabled unless this is set.
# WORDPRESS_MEDIA_UPLOAD_DIRS=/absolute/path/one,/absolute/path/two
# WORDPRESS_MEDIA_MAX_BYTES=52428800
# WORDPRESS_REQUEST_TIMEOUT_MS=30000
# WORDPRESS_MEDIA_ALLOW_PRIVATE_URLS=false
